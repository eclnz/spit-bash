source trip : Notes / [trip]
path trip: input/{trip}

default entities: {@key}={@value} separated "__"
default path: output/{@product}/{@entities}

operation copy(notes: Notes) -> Album /
command copy: cp -R {notes} {@output}
album = copy(trip)

operation pack(album: Album) -> Archive .tar
command pack: tar -cf {@output} -C {album} .
archive = pack(album)
