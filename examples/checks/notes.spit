check nonempty: test -s {@path}
check contains(word): grep -q {word} {@path}

source note : Text [day] @ check(nonempty)

default entities: {@key}={@value} separated "__"
default path: output/{@product}/{@entities}.txt
path note: input/{day}.txt

operation copy(note: Text) -> Text @ check(contains(today))
command copy: cp {note} {@output}
copied = copy(note)
