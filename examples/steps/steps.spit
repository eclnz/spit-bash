source note : Lines [name]

entities: {key}={value} separated "__" empty "global"
default path: output/{@product}/{@entities}.txt
path note: input/{name}.txt

operation sort_lines(input: Lines) -> Lines
command sort_lines: sort -u -o {@output} {input}

operation tidy(input: Lines) -> (result: Lines):
    cleaned = sort_lines(input)
    result = sort_lines(cleaned)

tidied = tidy(note)
